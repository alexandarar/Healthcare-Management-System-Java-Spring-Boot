{
  "info": {
    "name": "Hospital Management System API",
    "description": "Core endpoints for the HMS backend. Import into Postman, set the 'baseUrl' and 'accessToken' collection variables (accessToken is filled automatically after Login).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Patient",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Jane Doe\",\n  \"email\": \"jane@example.com\",\n  \"password\": \"Password123\",\n  \"phoneNumber\": \"1234567890\",\n  \"role\": \"PATIENT\",\n  \"dateOfBirth\": \"1995-05-10\",\n  \"gender\": \"FEMALE\",\n  \"address\": \"123 Main St\",\n  \"bloodGroup\": \"O+\",\n  \"emergencyContactName\": \"John Doe\",\n  \"emergencyContactPhone\": \"0987654321\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json().data;",
                  "pm.collectionVariables.set('accessToken', data.accessToken);",
                  "pm.collectionVariables.set('refreshToken', data.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@hms.local\",\n  \"password\": \"Admin@123\"\n}"
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/refresh",
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Doctors",
      "item": [
        {
          "name": "Create Doctor (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/doctors",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Dr. Alice Smith\",\n  \"email\": \"alice.smith@hms.local\",\n  \"password\": \"Password123\",\n  \"phoneNumber\": \"5551234567\",\n  \"specialization\": \"Cardiology\",\n  \"qualification\": \"MD\",\n  \"yearsOfExperience\": 8,\n  \"consultationFee\": 150.00,\n  \"availability\": \"MON-FRI 09:00-17:00\"\n}"
            }
          }
        },
        {
          "name": "List Doctors",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/doctors"
          }
        }
      ]
    },
    {
      "name": "Patients",
      "item": [
        {
          "name": "List / Search Patients",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/patients?search=jane"
          }
        },
        {
          "name": "Get My Profile (Patient)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/patients/me"
          }
        }
      ]
    },
    {
      "name": "Appointments",
      "item": [
        {
          "name": "Book Appointment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/appointments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": 1,\n  \"doctorId\": 1,\n  \"appointmentDateTime\": \"2026-10-01T10:00:00\",\n  \"reason\": \"Routine checkup\"\n}"
            }
          }
        },
        {
          "name": "Update Appointment Status",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/appointments/1/status",
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"CONFIRMED\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Medical Records",
      "item": [
        {
          "name": "Create Medical Record (Doctor)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/medical-records",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": 1,\n  \"symptoms\": \"Fever, headache\",\n  \"diagnosis\": \"Viral infection\",\n  \"treatmentNotes\": \"Rest and fluids\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Prescriptions",
      "item": [
        {
          "name": "Create Prescription (Doctor)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/prescriptions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": 1,\n  \"medicines\": [\n    { \"name\": \"Paracetamol\", \"dosage\": \"500mg\", \"frequency\": \"Twice daily\", \"duration\": \"5 days\", \"instructions\": \"After food\" }\n  ],\n  \"generalInstructions\": \"Drink plenty of water\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Billing",
      "item": [
        {
          "name": "Generate Bill",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/bills",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": 1,\n  \"items\": [\n    { \"chargeType\": \"CONSULTATION\", \"description\": \"Doctor consultation\", \"amount\": 150.00 }\n  ]\n}"
            }
          }
        },
        {
          "name": "Record Payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/bills/1/payments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 150.00,\n  \"method\": \"CASH\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        { "name": "Admin Dashboard", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/dashboard/admin" } },
        { "name": "Doctor Dashboard", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/dashboard/doctor" } },
        { "name": "Patient Dashboard", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/dashboard/patient" } },
        { "name": "Receptionist Dashboard", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/dashboard/receptionist" } }
      ]
    }
  ]
}
